# Load these values into the API process environment. Do not commit live tokens.
VULNSUITE_AUTH_OIDC_ISSUER=https://identity.example.org/realms/security
VULNSUITE_AUTH_OIDC_AUDIENCE=vulnsuite-api
VULNSUITE_AUTH_JWKS_URL=https://identity.example.org/realms/security/protocol/openid-connect/certs
VULNSUITE_AUTH_JWT_ALGORITHMS='["RS256"]'
VULNSUITE_AUTH_TENANT_CLAIM=tenant_id
VULNSUITE_AUTH_ROLES_CLAIM=roles
VULNSUITE_AUTH_JWKS_CACHE_SECONDS=300
VULNSUITE_AUTH_MAX_TOKEN_LIFETIME_SECONDS=28800
# For a trusted offline public JWKS, unset JWKS_URL and set this instead:
# VULNSUITE_AUTH_JWKS_PATH=/etc/vulnsuite/identity-public-jwks.json
