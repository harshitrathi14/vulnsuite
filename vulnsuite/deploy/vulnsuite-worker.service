[Unit]
Description=VulnSuite worker
After=network.target docker.service
[Service]
User=nacl_pam_admin
WorkingDirectory=/mnt/harshitrathi/vulnsuite
EnvironmentFile=/mnt/harshitrathi/vulnsuite/runtime/server.env
Environment="PYTHONPATH=/mnt/harshitrathi/vulnsuite"
Environment="PATH=/mnt/harshitrathi/vulnsuite/.tools/bin:/mnt/harshitrathi/vulnsuite/.venv/bin:/mnt/harshitrathi/vulnsuite/.tools/prowler/bin:/mnt/harshitrathi/vulnsuite/.tools/checkov/bin:/usr/local/bin:/usr/bin:/usr/sbin"
ExecStart=/mnt/harshitrathi/vulnsuite/.venv/bin/celery -A vulnsuite.workers.celery_app worker --loglevel=INFO --concurrency=2 --queues=vulnsuite.default,vulnsuite.scan,vulnsuite.discovery,vulnsuite.report,vulnsuite.ai
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
MemoryMax=4G
CPUQuota=200%
[Install]
WantedBy=multi-user.target
