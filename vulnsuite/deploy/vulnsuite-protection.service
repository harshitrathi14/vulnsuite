[Unit]
Description=VulnSuite protection
After=network.target docker.service
[Service]
User=nacl_pam_admin
WorkingDirectory=/mnt/harshitrathi/vulnsuite
EnvironmentFile=/mnt/harshitrathi/vulnsuite/runtime/server.env
Environment="PYTHONPATH=/mnt/harshitrathi/vulnsuite"
Environment="PATH=/mnt/harshitrathi/vulnsuite/.tools/bin:/mnt/harshitrathi/vulnsuite/.venv/bin:/mnt/harshitrathi/vulnsuite/.tools/prowler/bin:/mnt/harshitrathi/vulnsuite/.tools/checkov/bin:/usr/local/bin:/usr/bin:/usr/sbin"
Environment=VULNSUITE_PROTECTION_CONFIG=/mnt/harshitrathi/vulnsuite/runtime/protection/server.json
ExecStart=/mnt/harshitrathi/vulnsuite/.venv/bin/uvicorn vulnsuite.protection.service:create_app --factory --host 127.0.0.1 --port 8139
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
MemoryMax=4G
CPUQuota=200%
[Install]
WantedBy=multi-user.target
