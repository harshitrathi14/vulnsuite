# Copy to a private environment file; fill every blank before use.
# Generate each password independently with: openssl rand -hex 32
# DB_PASSWORD permits 32..128 letters/digits/underscore/hyphen because it also
# appears in a database URL. Never reuse the bootstrap credential in the app.
DB_PASSWORD=
# Schema-owner role (vulnsuite_migrator); only the API container receives it.
DB_MIGRATOR_PASSWORD=
POSTGRES_BOOTSTRAP_PASSWORD=
# Redis broker/cache password (redis-server --requirepass).
REDIS_PASSWORD=
OIDC_ISSUER=https://identity.example.org/realms/security
OIDC_JWKS_URL=https://identity.example.org/realms/security/protocol/openid-connect/certs
OIDC_AUDIENCE=vulnsuite-api
OIDC_JWT_ALGORITHMS='["RS256"]'
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLES_CLAIM=roles
OIDC_JWKS_CACHE_SECONDS=300
OIDC_MAX_TOKEN_LIFETIME_SECONDS=28800
# Browser origins allowed to call the API (JSON list; "*" is rejected). Empty = none.
API_CORS_ORIGINS='[]'
# Tenant UUIDs the nightly beat discovery fans out to (JSON list).
SCHEDULED_DISCOVERY_TENANTS='[]'
DAST_ALLOWLIST='[]'
