[Unit]
Description=VulnSuite findings
After=network.target docker.service
[Service]
User=nacl_pam_admin
WorkingDirectory=/mnt/harshitrathi/vulnsuite
EnvironmentFile=/mnt/harshitrathi/vulnsuite/runtime/server.env
Environment="PYTHONPATH=/mnt/harshitrathi/vulnsuite"
Environment="PATH=/mnt/harshitrathi/vulnsuite/.tools/bin:/mnt/harshitrathi/vulnsuite/.venv/bin:/mnt/harshitrathi/vulnsuite/.tools/prowler/bin:/mnt/harshitrathi/vulnsuite/.tools/checkov/bin:/usr/local/bin:/usr/bin:/usr/sbin"
ExecStart=/mnt/harshitrathi/vulnsuite/.venv/bin/streamlit run vulnsuite/dashboard/streamlit_app.py --server.address=127.0.0.1 --server.port=8138 --server.baseUrlPath=VulnSuite/findings --server.headless=true --browser.gatherUsageStats=false
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
MemoryMax=4G
CPUQuota=200%
[Install]
WantedBy=multi-user.target
